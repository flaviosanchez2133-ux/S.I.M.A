# S.I.M.A Desktop - Variables de entorno (ejemplo)
# Este archivo NO se incluye en la build, solo es referencia

# Puerto del servidor (default: 4000)
PORT=4000

# Base de datos (SQLite para escritorio)
DB_CLIENT=sqlite3
DB_FILENAME=./sima.sqlite3

# Secrets JWT (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=sima-desktop-secret-key-change-in-production
JWT_REFRESH_SECRET=sima-desktop-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Directorio de uploads
UPLOADS_DIR=./uploads

# CORS (para desarrollo)
FRONTEND_URL=http://localhost:3000

# Modo de ejecución
NODE_ENV=production
